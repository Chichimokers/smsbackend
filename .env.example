# ===== DATABASE =====
DB_ENGINE=django.db.backends.postgresql
DB_NAME=smsproject
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ===== DAISY SMS API =====
DAISY_SMS_API_KEY=dfqIbuXQCkIXTk8wR7ObNkA20mN3W5
DAISY_SMS_API_URL=https://daisysms.com/stubs/handler_api.php

# ===== EXCHANGE RATE (Default - also stored in DB) =====
# 0.5 USD = 1200 CUP, therefore 1 USD = 2400 CUP
DEFAULT_EXCHANGE_RATE_CUP_PER_USD=2400



# ===== GOOGLE OAUTH =====
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ===== EMAIL CONFIGURATION (Gmail SMTP) =====
# For Gmail, you need to use an App Password (not your regular password)
# Steps to get App Password:
# 1. Go to Google Account > Security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to App passwords (search for it in account settings)
# 4. Generate a new app password for "Mail"
# 5. Use that 16-character password here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=globalrentasms@gmail.com
EMAIL_HOST_PASSWORD=xdie pevk qtlo gtym
DEFAULT_FROM_EMAIL=SMS Rental <your-email@gmail.com>

# ===== BACKEND URL =====
# URL of your backend API (for email verification links)
BACKEND_URL=https://smsrenta.com/api/v1/

# ===== FRONTEND URL =====
# URL where your frontend is hosted
FRONTEND_URL=https://smsrenta.com/

# ===== CACHE (Redis) =====
CACHE_URL=redis://redis:6379/1

# ===== TESTING / MOCKS =====
# Set to true to use mock DaisySMS client (no real API calls, $0 cost)
# Set to false to use real DaisySMS API (costs money)
MOCK_DAISY_SMS=false
