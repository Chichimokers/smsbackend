# ===== DJANGO =====
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars-long
ALLOWED_HOSTS=localhost,127.0.0.1,inventory.cloudns.be

# ===== DATABASE =====
DB_ENGINE=django.db.backends.postgresql
DB_NAME=smsproject
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ===== DAISY SMS API =====
DAISY_SMS_API_KEY=CGxjCoaoSylteuezxNy3rjhU71TfmB
DAISY_SMS_API_URL=https://daisysms.com/stubs/handler_api.php

# ===== EXCHANGE RATE (Default - also stored in DB) =====
DEFAULT_EXCHANGE_RATE_CUP_PER_USD=1200

# ===== GOOGLE OAUTH =====
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ===== CACHE (Redis) =====
CACHE_URL=redis://redis:6379/1

# ===== TESTING / MOCKS =====
# Set to true to use mock DaisySMS client (no real API calls, $0 cost)
# Set to false to use real DaisySMS API (costs money)
MOCK_DAISY_SMS=false
